{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "quantumenergybeds-vercel.vercel.app"
        }
      ],
      "destination": "https://www.quantumenergybeds.com/",
      "permanent": true
    },
    {
      "source": "/blog/science-of-vibrational-healing",
      "destination": "/blog/vibrational-healing-frequency-energy",
      "permanent": true
    },
    {
      "source": "/blog/understanding-biophotons",
      "destination": "/blog/cellular-energy-atp-light-therapy",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "quantumenergybeds-vercel.vercel.app"
        }
      ],
      "destination": "https://www.quantumenergybeds.com/:path*",
      "permanent": true
    }
  ]
}
